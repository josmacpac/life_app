# ==============================================================================
# life_app — Variables de entorno (único punto para todo el proyecto)
# Copia este archivo como .env y edita los valores.
# ==============================================================================

# === Ruta al repositorio frontend (relativa a docker/) ==========================
LIFE_FRONTEND_PATH=../frontend

# === API (Flask) ================================================================
FLASK_DEBUG=0
PORT=5000
CORS_ORIGINS=http://localhost
API_URL=http://localhost:5000

# === Frontend (Vue 3 + Vite) ====================================================
# Vite expone solo variables con prefijo VITE_
VITE_API_URL=http://localhost
